<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="cadastross.CadastroCliente"
             Shell.NavBarIsVisible="false"
             BackgroundColor="#cedeeb">

       <Grid>

              <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                     <RowDefinition Height="*"/>
                     <RowDefinition Height="*"/>
                     <RowDefinition Height="*"/>
                     <RowDefinition Height="*"/>
                     <RowDefinition Height="*"/>
                     <RowDefinition Height="*"/>
                     <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="*"/>
                     <ColumnDefinition Width="60"/>
                     <ColumnDefinition Width="Auto"/>
                     <ColumnDefinition Width="Auto"/>
                     <ColumnDefinition Width="Auto"/>
                     <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

    

              <Label Text="Cadastro dos Cliente"
                     FontSize="50"
                     Grid.ColumnSpan="5"
                     HorizontalOptions="Center"
                     VerticalOptions="Start"
                     FontFamily="letras.ttf"/>


              <Label x:Name="IdLabel"
                     Margin="5,0,0,10"
                     Grid.Row="1"
                     Grid.Column="0"/>

               <Label FontSize="20"
                     Text="Nome"
                     Grid.Row="1"
                     Margin="00,20,0,0"
                     Grid.Column="0"/>

               <Label FontSize="20"
                     Text="cpf"
                     Grid.Row="2"
                     Margin="00,20,0,0"
                     Grid.Column="0"/>

               <Label FontSize="20"
                     Text="endereço"
                     Grid.Row="3"
                     Margin="00,20,70,0"
                     Grid.Column="0"/>

                <Label FontSize="20"
                     Text="Email"
                     Margin="00,20,160,0"
                     Grid.Row="4"
                     Grid.Column="0"/>

              <Label Text="{Binding Id}"
                     HorizontalOptions="FillAndExpand"
                     Grid.Column="1"/>

              <Entry x:Name="Name"
                     Placeholder="digite seu nome"
                     FontSize="20"
                     Margin="100,5,20,0"
                     Grid.Row="1"
                     Grid.ColumnSpan="1"/>

              <Entry  x:Name="cpfEntry"
                      Placeholder="digite seu cpf"
                      FontSize="20"
                      Margin="100,5,0,0"
                      HorizontalOptions="FillAndExpand"
                      Grid.Row="2"
                      Grid.Column="0"/>

              <Entry  x:Name="endereçoEntry"
                      Placeholder="digite seu nome "
                      FontSize="20"
                      Margin="100,5,0,0"
                      HorizontalOptions="FillAndExpand"
                      Grid.Row="3"
                      Grid.Column="0"/>

              <Entry x:Name="GmailEntry"
                     Placeholder="digite o seu email"
                     FontSize="20"
                     Margin="100,5,0,0"
                     HorizontalOptions="FillAndExpand"
                     Grid.Row="4"
                     Grid.Column="0"/>


              <Button Text="Salvar"
                      FontSize="20"
                      WidthRequest="100"
                      VerticalOptions="Center"
                      BackgroundColor="Green"
                      TextColor="Black"
                      Clicked="SalvarCliente"
                      Grid.Row="7"
                      Margin="200,0,0,0"
                      Grid.Column="0"/>

             
        <Button Text="Cancelar"
                      FontSize="20"
                      WidthRequest="100"
                      BackgroundColor="Red"
                      VerticalOptions="Center"
                      TextColor="Black"
                      Clicked="Exluircancela"
                      Grid.Row="7"
                      Margin="0,0,110,0"
                      Grid.Column="0"/>

       <Button Text="volta"
              FontSize="20"
              WidthRequest="100"
              VerticalOptions="Center"
              Grid.Row="0"
              Grid.Column="1"
              Clicked="voltarr"/>

       </Grid>

</ContentPage>