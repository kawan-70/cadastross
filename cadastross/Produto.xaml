<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="cadastross.Produto"
             BackgroundColor="#b2a9f5">

    <AbsoluteLayout>

        <!-- Layout com os elementos principais -->
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1"
                    AbsoluteLayout.LayoutFlags="All">
            <Grid Padding="10">
                <!-- Define o layout de linhas e colunas -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Barra de pesquisa e botões de ação -->
                <Grid Grid.RowSpan="0"
                      Grid.ColumnSpan="0"
                      Grid.Column="3"
                      VerticalOptions="Center"
                      HorizontalOptions="FillAndExpand">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <SearchBar Placeholder="Pesquisar"
                               Grid.Column="0"
                               WidthRequest="250"
                               HorizontalOptions="FillAndExpand"
                               VerticalOptions="Center"/>
                    
                    <Button ImageSource="lapis.png"
                            Grid.Column="1"
                            FontSize="18"
                            WidthRequest="50"
                            Clicked="cadastroP"
                            VerticalOptions="Center"/>
                    
                    <Button ImageSource="mais.png"
                            Grid.Column="2"
                            FontSize="18"
                            Clicked="cadastroP"
                            WidthRequest="50"
                            VerticalOptions="Center"/>
                    
                    <Button ImageSource="menos.png"
                            Grid.Column="3"
                            FontSize="18"
                            WidthRequest="50"
                            VerticalOptions="Center"/>
                    
                    <Button ImageSource="seta.png"
                            Grid.Column="4"
                            FontSize="18"
                            WidthRequest="50"
                            VerticalOptions="Center"
                            Clicked="botâoVoltar"/>
                </Grid>

                <!-- Título -->
                <Label Text="Nome das Facções"
                       FontSize="20"
                       Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="5"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       Margin="0,10,0,10"/>

                <!-- Layout para os botões das facções -->
                <StackLayout Grid.Row="2"
                             Grid.Column="0"
                             Grid.ColumnSpan="5"
                             Orientation="Vertical"
                             HorizontalOptions="FillAndExpand"
                             VerticalOptions="Center">

                    <Button Text="digite seu nome"
                            FontSize="20"
                            Margin="0,5"
                            HorizontalOptions="FillAndExpand"
                            Clicked="botâocadastrar"/>

                     <Button Text="digite seu nome"
                            FontSize="20"
                            Margin="0,5"
                            HorizontalOptions="FillAndExpand"/>

                     <Button Text="digite seu nome"
                            FontSize="20"
                            Margin="0,5"
                            HorizontalOptions="FillAndExpand"/>

                     <Button Text="digite seu nome"
                            FontSize="20"
                            Margin="0,5"
                            HorizontalOptions="FillAndExpand"/>

                     <Button Text="digite seu nome"
                            FontSize="20"
                            Margin="0,5"
                            HorizontalOptions="FillAndExpand"/>
                </StackLayout>

                <!-- Título da tela -->
                <Label Text="Tela Inicial Dos Produtos"
                       FontSize="30"
                       Grid.Row="3"
                       Grid.Column="0"
                       Grid.ColumnSpan="5"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       FontFamily="letras.ttf"/>

                <!-- Imagem do C# -->
                <Image Source="maquinas.png"
                       Aspect="AspectFit"
                       Grid.Row="3"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="300,50,0,0"/>
            </Grid>
        </ScrollView>
    </AbsoluteLayout>
</ContentPage>
