<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="cadastross.Produto"
             BackgroundColor="White">

    <AbsoluteLayout>
        <!-- Imagem de fundo -->
        <Image Source="maquinas.png"
               Aspect="Fill"
               AbsoluteLayout.LayoutBounds="0,0,1,1"
               AbsoluteLayout.LayoutFlags="All"/>
        
        <!-- Layout com os elementos principais -->
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1"
                    AbsoluteLayout.LayoutFlags="All">
            <Grid Padding="10">
                <!-- Define o layout de linhas e colunas -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Barra de pesquisa e botões -->
                <SearchBar Placeholder="pesquisar"
                           Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="4"
                           WidthRequest="250"
                           HorizontalOptions="Center"/>

                <Button ImageSource="lapis.png"
                        FontSize="18"
                        Grid.Row="0"
                        Grid.Column="1"
                        WidthRequest="50"/>

                <Button ImageSource="mais.png"
                        FontSize="18"
                        Grid.Row="0"
                        Grid.Column="2"
                        WidthRequest="50"/>

                <Button ImageSource="menos.png"
                        FontSize="18"
                        Grid.Row="0"
                        Grid.Column="3"
                        WidthRequest="50"/>

                <Button ImageSource="seta.png"
                        FontSize="18"
                        Grid.Row="0"
                        Grid.Column="4"
                        WidthRequest="50"/>

                <!-- Título -->
                <Label Text="nome das facções"
                       FontSize="20"
                       Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="4"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       Margin="0,10,0,10"/>

                <!-- Botões das facções -->
                <Button Text="facção da vilandia"
                        FontSize="20"
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,5"/>
                
                <Button Text="facção da vilandia"
                        FontSize="20"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,5"/>

                <Button Text="facção da vilandia"
                        FontSize="20"
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="0,5"/>

                <Button Text="facção da vilandia"
                        FontSize="20"
                        Grid.Row="2"
                        Grid.Column="3"
                        Margin="0,5"/>

                <Button Text="facção da vilandia"
                        FontSize="20"
                        Grid.Row="2"
                        Grid.Column="4"
                        Margin="0,5"/>

                <!-- Título da tela e imagem -->
                <Label Text="Tela Inicial Dos Produtos"
                       FontSize="30"
                       Grid.Row="3"
                       Grid.Column="0"
                       Grid.ColumnSpan="4"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       FontFamily="letras.ttf"/>
                
                <Image Source="maquinas.png"
                       Aspect="Center"
                       Grid.Row="4"
                       Grid.Column="0"
                       Grid.ColumnSpan="4"/>
            </Grid>
        </ScrollView>
    </AbsoluteLayout>
</ContentPage>
